# قاعدة البيانات (Supabase)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=anon-key
SUPABASE_SERVICE_ROLE_KEY=service_role-key   # يُستخدم خوادم الإدارة فقط (لا يُكشف)

# عند النشر
BASIC_AUTH_ENABLED=false

# مستخدم المدير عند أول تشغيل (اختياري — للـ seed فقط)
# ADMIN_EMAIL=admin@hasdo.org
# ADMIN_PASSWORD=hasdo-2026!
# ADMIN_NAME=مدير الموقع